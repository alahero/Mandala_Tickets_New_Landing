<!-- ------------------------------------------------------------------
     GA4 ecommerce — view_item   (añadido 2026-07-24)
     Se auto-limita a fichas de producto: solo actúa si existe
     #identificador. En admin, home o carrito no hace nada.
     Vanilla JS y envuelto en try/catch: no puede romper la página.
     Doc: docs/13-embudo-ecommerce-y-posthog.md
     ------------------------------------------------------------------ -->
<script>
(function () {
  try {
    var el = document.getElementById('identificador');
    if (!el) return;                                  // no es ficha de producto
    var a = function (n) { return el.getAttribute(n) || ''; };
    // OJO: 18 vistas más (calendario, listados de disco, bottle-service, y varias
    // del admin) también usan #identificador, pero SIN datos de producto. Sin id o
    // sin precio válido no hay ficha que medir: salir en vez de mandar un evento
    // con value=0 e item_id vacío, que ensucia el informe de view_item.
    var pid = a('prd');
    var precio = parseFloat(a('precio'));
    if (!pid || isNaN(precio)) return;
    // La ficha puede estar en MXN, USD o EUR (mt_productos.moneda). No asumir MXN.
    var cur = (a('moneda') || '').toUpperCase();
    if (cur !== 'MXN' && cur !== 'USD' && cur !== 'EUR') cur = 'MXN';
    window.dataLayer = window.dataLayer || [];
    window.dataLayer.push({ ecommerce: null });
    window.dataLayer.push({
      event: 'view_item',
      ecommerce: {
        affiliation: 'MandalaTickets',
        currency: cur,
        value: precio,
        items: [{
          item_id: pid,
          item_name: a('nombre_disco'),
          item_brand: 'MandalaTickets',
          item_category: a('nombre'),
          item_variant: '',
          quantity: 1,
          price: precio,
          index: 1
        }]
      }
    });
  } catch (e) { /* el tracking nunca debe romper la ficha */ }
})();
</script>
